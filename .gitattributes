# Normalize to LF in repo; override for Windows scripts
* text=auto eol=lf

# Common text files
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.ini  text eol=lf

# Shell scripts
*.sh   text eol=lf

# Windows scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
