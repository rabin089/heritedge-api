# Development Environment Variables
# Copy this to .env.dev for local development

# Database Configuration (for local PostgreSQL)
DATABASE_URL=postgresql://postgres:admin!@localhost:5432/heritage-db

# JWT Configuration
SECRET_KEY=devsecretkey123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# MinIO/S3 Configuration (for local development)
# You can use local MinIO or comment out these lines if not needed
MINIO_ENDPOINT=s3.rabindulal.com.np
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_REGION=us-east-1
MINIO_PATH_STYLE=true
MINIO_ACCESS_KEY=heritedge_admin
MINIO_SECRET_KEY=heritEdge@1937
MINIO_BUCKET=heritage-bucket
MINIO_PUBLIC_BASE_URL=https://s3.rabindulal.com.np:9000/heritage-bucket

# Optional: Image domain validation (comma-separated)
# IMAGE_ALLOWED_DOMAINS=localhost,127.0.0.1,imgur.com,example.com

# Development settings
DEBUG=true
ENVIRONMENT=development
